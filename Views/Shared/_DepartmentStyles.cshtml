<style>
    body.dept-theme {
        background: #e8eef5;
        color: #122033;
        font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    }

    body.dept-theme header .dept-nav {
        background: #0f2744 !important;
        border-bottom: 0 !important;
        margin-bottom: 0 !important;
        box-shadow: none !important;
    }

    body.dept-theme .dept-nav .navbar-brand,
    body.dept-theme .dept-nav .nav-link {
        color: #f4f7fb !important;
        font-weight: 600;
    }

    body.dept-theme .dept-nav .nav-link:hover,
    body.dept-theme .dept-nav .nav-link.active {
        color: #7eb6ff !important;
    }

    body.dept-theme .dept-nav .navbar-toggler {
        border-color: rgba(255, 255, 255, 0.35);
    }

    body.dept-theme .dept-container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 3rem;
    }

    body.dept-theme .dept-footer {
        background: #0f2744;
        color: #9bb0c9;
        border-top: 0 !important;
    }

    body.dept-theme .dept-footer a {
        color: #cfe2ff;
    }

    .dept-hero {
        background: #0f2744;
        color: #fff;
        border-radius: 16px;
        padding: 1.75rem 1.75rem 1.5rem;
        margin-bottom: 1.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
    }

    .dept-hero h1 {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: #fff;
    }

    .dept-kicker {
        margin: 0 0 0.35rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #7eb6ff;
    }

    .dept-sub {
        margin: 0.4rem 0 0;
        color: #c5d4e6;
        font-size: 0.95rem;
    }

    .dept-hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
    }

    .dept-metrics {
        display: flex;
        gap: 0.75rem;
    }

    .dept-metric {
        min-width: 92px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        padding: 0.65rem 0.9rem;
        text-align: center;
    }

    .dept-metric strong {
        display: block;
        font-size: 1.35rem;
        line-height: 1.1;
        color: #fff;
    }

    .dept-metric span {
        font-size: 0.72rem;
        color: #9bb0c9;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .dept-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        padding: 0.55rem 1.05rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid transparent;
        line-height: 1.2;
    }

    .dept-btn-primary {
        background: #2f7de1;
        color: #fff !important;
    }

    .dept-btn-primary:hover {
        background: #226dcc;
        color: #fff !important;
    }

    .dept-btn-ghost {
        background: transparent;
        color: #d7e6f8 !important;
        border-color: rgba(255, 255, 255, 0.25);
    }

    .dept-btn-ghost:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #fff !important;
    }

    .dept-btn-outline {
        background: #fff;
        color: #0f2744 !important;
        border-color: #c9d4e2;
    }

    .dept-btn-outline:hover {
        background: #f3f6fa;
        color: #0f2744 !important;
    }

    .dept-btn-danger {
        background: #c0392b;
        color: #fff !important;
    }

    .dept-btn-danger:hover {
        background: #a93226;
        color: #fff !important;
    }

    .dept-btn-sm {
        padding: 0.32rem 0.7rem;
        font-size: 0.82rem;
        border-radius: 8px;
    }

    .dept-panel {
        background: #fff;
        border: 1px solid #d5deea;
        border-radius: 16px;
        overflow: hidden;
    }

    .dept-panel-body {
        padding: 1.5rem 1.6rem 1.7rem;
    }

    .dept-panel-narrow {
        max-width: 680px;
    }

    .dept-flash {
        background: #e7f6ec;
        color: #1e6b3a;
        border: 1px solid #b7e0c4;
        border-radius: 12px;
        padding: 0.8rem 1rem;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .dept-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

    .dept-table thead th {
        background: #f4f7fb;
        color: #5b6d82;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.9rem 1.1rem;
        border-bottom: 1px solid #d5deea;
        white-space: nowrap;
    }

    .dept-table tbody td {
        padding: 1rem 1.1rem;
        border-bottom: 1px solid #edf1f6;
        vertical-align: middle;
        color: #1c2b3d;
    }

    .dept-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .dept-table tbody tr:hover td {
        background: #f7faff;
    }

    .dept-name {
        font-weight: 700;
        color: #0f2744;
    }

    .dept-code {
        display: inline-block;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.8rem;
        font-weight: 700;
        color: #0f2744;
        background: #eaf1fa;
        border: 1px solid #c9d8ec;
        border-radius: 6px;
        padding: 0.15rem 0.5rem;
    }

    .dept-desc {
        color: #5b6d82;
        max-width: 280px;
    }

    .dept-pill {
        display: inline-block;
        border-radius: 999px;
        padding: 0.22rem 0.7rem;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .dept-pill-on {
        background: #d9f3e3;
        color: #157347;
    }

    .dept-pill-off {
        background: #e8edf3;
        color: #5b6d82;
    }

    .dept-actions {
        display: flex;
        gap: 0.4rem;
        justify-content: flex-end;
    }

    .dept-empty {
        text-align: center;
        padding: 4rem 1.5rem;
        color: #5b6d82;
    }

    .dept-empty h2 {
        color: #0f2744;
        font-size: 1.25rem;
        margin-bottom: 0.4rem;
    }

    .dept-form .form-label {
        font-weight: 600;
        color: #0f2744;
        margin-bottom: 0.35rem;
    }

    .dept-form .form-control {
        border: 1px solid #c9d4e2;
        border-radius: 10px;
        padding: 0.65rem 0.8rem;
        background: #f8fafc;
    }

    .dept-form .form-control:focus {
        background: #fff;
        border-color: #2f7de1;
        box-shadow: 0 0 0 3px rgba(47, 125, 225, 0.18);
    }

    .dept-form-actions {
        display: flex;
        gap: 0.6rem;
        margin-top: 0.5rem;
    }

    .dept-warn {
        background: #fdecea;
        border: 1px solid #f5c2c0;
        color: #8c2f28;
        border-radius: 12px;
        padding: 0.95rem 1rem;
        margin-bottom: 1.1rem;
        font-weight: 600;
    }

    .dept-details {
        margin: 0;
    }

    .dept-detail {
        display: grid;
        grid-template-columns: 140px 1fr;
        gap: 0.75rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid #edf1f6;
    }

    .dept-detail:last-child {
        border-bottom: 0;
    }

    .dept-detail dt {
        margin: 0;
        color: #5b6d82;
        font-weight: 600;
    }

    .dept-detail dd {
        margin: 0;
        color: #122033;
        font-weight: 600;
    }

    .dept-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 1rem;
        align-items: center;
    }

    .dept-toolbar .form-control {
        min-width: 160px;
        flex: 1;
        border: 1px solid #c9d4e2;
        border-radius: 10px;
        padding: 0.55rem 0.75rem;
        background: #fff;
    }

    .dept-toolbar input[type="search"] {
        flex: 2;
        min-width: 220px;
    }

    .dept-sort {
        color: #5b6d82;
        text-decoration: none;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.72rem;
    }

    .dept-sort:hover,
    .dept-sort.is-active {
        color: #0f2744;
    }

    .dept-pager {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.9rem 1.1rem;
        border-top: 1px solid #edf1f6;
        background: #f8fafc;
    }

    .dept-pager-meta {
        margin: 0;
        color: #5b6d82;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .dept-pager-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
    }

    .dept-page {
        min-width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        text-decoration: none;
        color: #0f2744;
        font-weight: 700;
        font-size: 0.85rem;
        border: 1px solid transparent;
    }

    .dept-page.is-current {
        background: #0f2744;
        color: #fff;
    }

    .dept-btn.is-disabled {
        opacity: 0.45;
        pointer-events: none;
    }

    @@media (max-width: 768px) {
        .dept-hero {
            padding: 1.25rem;
        }

        .dept-metrics {
            width: 100%;
        }

        .dept-metric {
            flex: 1;
        }

        .dept-detail {
            grid-template-columns: 1fr;
            gap: 0.2rem;
        }
    }
</style>
