@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["PageTheme"] = "org";
    ViewData["CurrentNav"] = "privacy";
}

<div class="privacy-page">

    <!-- ================================
         PRIVACY HERO SECTION
         ================================ -->

    <section class="privacy-hero">

        <div class="privacy-hero-content">

            <div>
                <div class="privacy-eyebrow">
                    SECURITY & PRIVACY
                </div>

                <h1>Privacy Policy</h1>

                <p>
                    Learn how SEPMS handles employee and department
                    information and helps protect organizational data.
                </p>
            </div>


            <div class="privacy-stats">

                <div class="privacy-stat-card">
                    <div class="privacy-stat-icon">
                        🔒
                    </div>

                    <div>
                        <strong>SECURE</strong>
                        <span>DATA</span>
                    </div>
                </div>


                <div class="privacy-stat-card">
                    <div class="privacy-stat-icon">
                        🛡
                    </div>

                    <div>
                        <strong>PRIVACY</strong>
                        <span>FIRST</span>
                    </div>
                </div>

            </div>

        </div>

    </section>


    <!-- ================================
         INTRODUCTION
         ================================ -->

    <section class="privacy-card">

        <div class="privacy-section-heading">

            <div class="privacy-section-icon">
                ℹ
            </div>

            <div>
                <span>ABOUT SEPMS</span>
                <h2>Introduction</h2>
            </div>

        </div>

        <p>
            SEPMS (Staff and Employee Profile Management System)
            is a web-based application used to manage employee
            and department information within an organization.
        </p>

        <p>
            This Privacy Policy explains what information may be
            stored in SEPMS, how the information is used, and
            the responsibilities of users who access the system.
        </p>

    </section>


    <!-- ================================
         INFORMATION WE COLLECT
         ================================ -->

    <section class="privacy-card">

        <div class="privacy-section-heading">

            <div class="privacy-section-icon">
                👤
            </div>

            <div>
                <span>EMPLOYEE DATA</span>
                <h2>Information We Collect</h2>
            </div>

        </div>


        <div class="privacy-data-grid">

            <div class="privacy-data-item">
                <strong>Employee Name</strong>
                <span>Employee identification information</span>
            </div>

            <div class="privacy-data-item">
                <strong>Email Address</strong>
                <span>Employee communication details</span>
            </div>

            <div class="privacy-data-item">
                <strong>Phone Number</strong>
                <span>Employee contact information</span>
            </div>

            <div class="privacy-data-item">
                <strong>Job Title</strong>
                <span>Employee professional information</span>
            </div>

            <div class="privacy-data-item">
                <strong>Department</strong>
                <span>Organizational assignment</span>
            </div>

            <div class="privacy-data-item">
                <strong>Date of Joining</strong>
                <span>Employment information</span>
            </div>

        </div>

    </section>


    <!-- ================================
         HOW INFORMATION IS USED
         ================================ -->

    <section class="privacy-card">

        <div class="privacy-section-heading">

            <div class="privacy-section-icon">
                📋
            </div>

            <div>
                <span>DATA USAGE</span>
                <h2>How We Use Information</h2>
            </div>

        </div>


        <div class="privacy-list">

            <div class="privacy-list-item">
                <span>01</span>
                <p>
                    Manage employee profiles and organizational records.
                </p>
            </div>

            <div class="privacy-list-item">
                <span>02</span>
                <p>
                    Assign employees to their respective departments.
                </p>
            </div>

            <div class="privacy-list-item">
                <span>03</span>
                <p>
                    Search, filter, sort, and manage employee records.
                </p>
            </div>

            <div class="privacy-list-item">
                <span>04</span>
                <p>
                    Maintain accurate organizational information.
                </p>
            </div>

        </div>

    </section>


    <!-- ================================
         DATA SECURITY
         ================================ -->

    <section class="privacy-card privacy-security-card">

        <div class="privacy-section-heading">

            <div class="privacy-section-icon">
                🛡
            </div>

            <div>
                <span>PROTECTION</span>
                <h2>Data Security</h2>
            </div>

        </div>

        <p>
            SEPMS is designed to keep organizational information
            within the application and database environment.
        </p>

        <p>
            Access to employee information should be limited to
            authorized users. Authentication and role-based
            authorization can be used to provide additional
            protection for sensitive employee information.
        </p>

    </section>


    <!-- ================================
         DATA RETENTION
         ================================ -->

    <section class="privacy-card">

        <div class="privacy-section-heading">

            <div class="privacy-section-icon">
                🗄
            </div>

            <div>
                <span>RECORD MANAGEMENT</span>
                <h2>Data Retention</h2>
            </div>

        </div>

        <p>
            Employee and department records may be retained for
            as long as they are required for organizational,
            operational, or legal purposes.
        </p>

        <p>
            Organizations should define appropriate retention
            and deletion policies according to their requirements.
        </p>

    </section>


    <!-- ================================
         USER RESPONSIBILITY
         ================================ -->

    <section class="privacy-card">

        <div class="privacy-section-heading">

            <div class="privacy-section-icon">
                👥
            </div>

            <div>
                <span>USER RESPONSIBILITY</span>
                <h2>User Responsibilities</h2>
            </div>

        </div>

        <div class="privacy-responsibilities">

            <div>
                <strong>Protect Credentials</strong>
                <p>
                    Users should keep their login credentials confidential.
                </p>
            </div>

            <div>
                <strong>Use Data Responsibly</strong>
                <p>
                    Employee information should only be accessed
                    for legitimate organizational purposes.
                </p>
            </div>

            <div>
                <strong>Report Security Issues</strong>
                <p>
                    Any suspected unauthorized access should be
                    reported to the system administrator.
                </p>
            </div>

        </div>

    </section>


    <!-- ================================
         CONTACT
         ================================ -->

    <section class="privacy-contact">

        <div>
            <span>QUESTIONS?</span>

            <h2>Privacy & Security</h2>

            <p>
                For privacy-related questions or concerns,
                please contact the SEPMS system administrator.
            </p>
        </div>

        <div class="privacy-contact-badge">
            SEPMS
        </div>

    </section>


    <!-- ================================
         LAST UPDATED
         ================================ -->

    <div class="privacy-last-updated">
        Last updated: September 2026
    </div>

</div>