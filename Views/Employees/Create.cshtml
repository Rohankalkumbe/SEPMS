@model SEPMS.Domain.Entities.Employee

@{
    ViewData["Title"] = "New employee";
}

<div class="dept-hero">
    <div>
        <p class="dept-kicker">People</p>
        <h1>New employee</h1>
        <p class="dept-sub">Add a person and assign them to a department.</p>
    </div>
    <a asp-action="Index" class="dept-btn dept-btn-ghost">Back to list</a>
</div>

<div class="dept-panel dept-panel-narrow">
    <div class="dept-panel-body">
        <form asp-action="Create" method="post" class="dept-form">
            <partial name="_EmployeeForm" />
            <div class="dept-form-actions">
                <button type="submit" class="dept-btn dept-btn-primary">Save employee</button>
                <a asp-action="Index" class="dept-btn dept-btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
