@model PagedResult<Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="dept-hero">
    <div>
        <p class="dept-kicker">People</p>
        <h1>Employees</h1>
        <p class="dept-sub">Assign staff to departments and keep their contact details up to date.</p>
    </div>
    <div class="dept-hero-actions">
        <div class="dept-metrics">
            <div class="dept-metric">
                <strong>@Model.TotalInDatabase</strong>
                <span>Total</span>
            </div>
            <div class="dept-metric">
                <strong>@Model.ActiveInDatabase</strong>
                <span>Active</span>
            </div>
        </div>
        <a asp-action="Create" class="dept-btn dept-btn-primary">New employee</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="dept-flash">@success</div>
}

<form method="get" asp-action="Index" class="dept-toolbar">
    <input type="hidden" name="sort" value="@Model.Sort" />
    <input type="hidden" name="dir" value="@Model.Dir" />

    <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Search name, email, phone, or title" />

    <select class="form-control" name="status">
        <option value="all" selected="@(Model.Status == "all")">All statuses</option>
        <option value="active" selected="@(Model.Status == "active")">Active</option>
        <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
    </select>

    <select class="form-control" name="departmentId" asp-items="ViewBag.FilterDepartments">
        <option value="">All departments</option>
    </select>

    <select class="form-control" name="pageSize">
        <option value="5" selected="@(Model.PageSize == 5)">5 per page</option>
        <option value="10" selected="@(Model.PageSize == 10)">10 per page</option>
        <option value="25" selected="@(Model.PageSize == 25)">25 per page</option>
    </select>

    <button type="submit" class="dept-btn dept-btn-primary">Apply</button>
    <a asp-action="Index" class="dept-btn dept-btn-outline">Reset</a>
</form>

<div class="dept-panel">
    @if (Model.TotalInDatabase == 0)
    {
        <div class="dept-empty">
            <h2>No employees yet</h2>
            <p>Create an employee and link them to a department.</p>
            <a asp-action="Create" class="dept-btn dept-btn-primary">New employee</a>
        </div>
    }
    else if (!Model.Items.Any())
    {
        <div class="dept-empty">
            <h2>No matching employees</h2>
            <p>Try a different search or clear the filters.</p>
            <a asp-action="Index" class="dept-btn dept-btn-outline">Clear filters</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="dept-table">
                <thead>
                    <tr>
                        <partial name="_SortHeading" model='("Name", "name", (ListQuery)Model)' />
                        <partial name="_SortHeading" model='("Email", "email", (ListQuery)Model)' />
                        <partial name="_SortHeading" model='("Phone", "phone", (ListQuery)Model)' />
                        <partial name="_SortHeading" model='("Department", "department", (ListQuery)Model)' />
                        <partial name="_SortHeading" model='("Title", "title", (ListQuery)Model)' />
                        <partial name="_SortHeading" model='("Status", "status", (ListQuery)Model)' />
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model.Items)
                    {
                        <tr>
                            <td class="dept-name">@employee.Name</td>
                            <td>@employee.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(employee.Phone) ? "—" : employee.Phone)</td>
                            <td>@(employee.Department?.DepartmentName ?? "—")</td>
                            <td class="dept-desc">@employee.JobTitle</td>
                            <td>
                                @if (employee.IsActive)
                                {
                                    <span class="dept-pill dept-pill-on">Active</span>
                                }
                                else
                                {
                                    <span class="dept-pill dept-pill-off">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="dept-actions">
                                    <a asp-action="Edit" asp-route-id="@employee.EmployeeId" class="dept-btn dept-btn-outline dept-btn-sm">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@employee.EmployeeId" class="dept-btn dept-btn-danger dept-btn-sm">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="(ListQuery)Model" />
    }
</div>
